#!/bin/sh /etc/rc.common
# OpenWrt procd init script for gatus

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/gatus
DEFAULT_CONFIG=/etc/gatus/config.yaml
DATA_DIR=/var/lib/gatus

start_service() {
	local enabled config_path

	config_load gatus
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get config_path main config "$DEFAULT_CONFIG"

	mkdir -p "$DATA_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env GATUS_CONFIG_PATH="$config_path"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config_path"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger gatus
}
